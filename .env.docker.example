# Copy → .env ở thư mục gốc repo rồi chạy: docker compose up --build

# Backend (bắt buộc cho AI chat)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-lite
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OPENWEATHER_API_KEY=

# CORS — origin trình duyệt truy cập FE
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

LOG_DIR=logs
LOG_LEVEL=INFO

# Frontend — URL API mà trình duyệt gọi (không dùng tên service Docker)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Tuỳ chọn đổi port host
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
